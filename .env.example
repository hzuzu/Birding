# ============================================================
# Bird Feeder Camera App — Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Then edit .env with a text editor (Notepad, TextEdit, etc.)
# NEVER share .env — it contains your private API key.
# ============================================================


# ------------------------------------------------------------
# CAMERA
# ------------------------------------------------------------
# Your camera's RTSP stream URL.
# Replace 192.168.1.100 with your camera's actual IP address.
# Replace mypassword with the password you set in the camera app.
#
# Wyze Cam v3 (primary camera — after RTSP firmware flash, see README):
CAMERA_URL=rtsp://admin:mypassword@192.168.1.100/live
#
# Reolink cameras (E1 Outdoor, RLC-810A) — alternative:
# CAMERA_URL=rtsp://admin:mypassword@192.168.1.100//h264Preview_01_main
#
# Use your laptop's built-in webcam for testing (no camera needed):
# CAMERA_URL=0


# ------------------------------------------------------------
# REGION OF INTEREST (ROI) — where your feeder ring appears on screen
# ------------------------------------------------------------
# After running  python app.py --calibrate  you will see the camera
# feed with a rectangle drawn on it. Adjust these numbers until
# the rectangle tightly surrounds the feeder ring in the image.
#
# ROI_X and ROI_Y = top-left corner of the box (pixels from top-left of image)
# ROI_WIDTH and ROI_HEIGHT = size of the box in pixels
#
# Default values cover the center portion of a 1280x720 image.
# Change these after running calibration.
ROI_X=320
ROI_Y=180
ROI_WIDTH=640
ROI_HEIGHT=360

# Advanced: elliptical ROI (optional, leave blank to use rectangle above)
# Useful when your feeder ring appears as an arc/ellipse in the side view.
# ROI_CENTER_X=640
# ROI_CENTER_Y=360
# ROI_SEMI_MAJOR=280
# ROI_SEMI_MINOR=120
# ROI_ANGLE=0


# ------------------------------------------------------------
# MOTION DETECTION TUNING
# ------------------------------------------------------------
# How many pixels must change to count as "something moved"
# Increase if wind/leaves cause false detections. Decrease if birds are missed.
MOTION_THRESHOLD=500

# Minimum seconds between two detections (prevents burst-capturing same bird)
MOTION_COOLDOWN_SECS=10

# Smallest blob of motion to care about (pixels squared). Filters out insects/rain.
MIN_CONTOUR_AREA=300


# ------------------------------------------------------------
# CLAUDE AI — Bird Identification
# ------------------------------------------------------------
# Get your free API key at: https://console.anthropic.com
# Click "API Keys" → "Create Key" → paste it below
ANTHROPIC_API_KEY=sk-ant-your-key-here

# AI model used for bird identification (leave as-is)
CLAUDE_MODEL=claude-haiku-4-5-20251001


# ------------------------------------------------------------
# WEB DASHBOARD
# ------------------------------------------------------------
# Address to open in your browser: http://localhost:5000
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# How many recent sightings to show on the dashboard
MAX_SIGHTINGS_DISPLAY=50


# ------------------------------------------------------------
# STORAGE
# ------------------------------------------------------------
# Folder where bird photos are saved (created automatically)
PHOTOS_DIR=./photos

# SQLite database file for sightings history
DB_PATH=./birding.db
